  <style>
    :root {
      --pink:        #FF3FA4;
      --pink-hot:    #E8007A;
      --pink-light:  #FF85C8;
      --pink-pale:   #FFD6EC;
      --pink-ghost:  #FFF0F8;
      --green:       #B8F2C8;
      --green-mid:   #7AE08A;
      --green-dark:  #2D9E4A;
      --green-deep:  #1A6B30;
      --cream:       #FFF8FC;
      --cream-warm:  #FEF3F9;
      --dark:        #130F1A;
      --text:        #2E2840;
      --text-muted:  #7A718C;
      --white:       #ffffff;
      --shadow-pink: 0 20px 60px rgba(255,63,164,0.18);
      --shadow-soft: 0 8px 32px rgba(20,15,30,0.08);
      --r-sm:  16px;
      --r-md:  24px;
      --r-lg:  36px;
      --r-xl:  48px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }
    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--text);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }
    img { display: block; max-width: 100%; }
    a   { text-decoration: none; color: inherit; }

    /* NAV */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 200;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 3rem;
      background: rgba(255,248,252,0.88);
      backdrop-filter: blur(18px) saturate(1.6);
      -webkit-backdrop-filter: blur(18px) saturate(1.6);
      border-bottom: 1px solid rgba(255,63,164,0.1);
      transition: padding 0.3s ease;
    }
    nav.scrolled { padding: 0.65rem 3rem; }
    .nav-logo { font-family: 'Pacifico', cursive; font-size: 1.35rem; color: var(--pink); }
    .nav-links { display: flex; gap: 2rem; list-style: none; }
    .nav-links a {
      font-size: 0.78rem; font-weight: 600;
      letter-spacing: 0.07em; text-transform: uppercase;
      color: var(--text-muted); transition: color 0.2s; position: relative;
    }
    .nav-links a::after {
      content: ''; position: absolute; bottom: -3px; left: 0; right: 0;
      height: 2px; background: var(--pink);
      transform: scaleX(0); transform-origin: left; transition: transform 0.3s ease;
    }
    .nav-links a:hover { color: var(--pink); }
    .nav-links a:hover::after { transform: scaleX(1); }
    .nav-cta {
      background: var(--pink); color: #fff;
      padding: 0.5rem 1.3rem; border-radius: 100px;
      font-size: 0.8rem; font-weight: 700;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .nav-cta:hover { transform: translateY(-2px); box-shadow: var(--shadow-pink); }

    /* HERO */
    #hero {
      min-height: 100vh;
      display: grid; grid-template-columns: 1fr 1fr;
      align-items: center; gap: 4rem;
      padding: 8rem 4rem 5rem;
      position: relative;
    }
    .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .hero-bg svg { width: 100%; height: 100%; }
    .hero-bg-grid {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      background-image:
        linear-gradient(rgba(255,63,164,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,63,164,0.04) 1px, transparent 1px);
      background-size: 60px 60px;
    }
    .hero-text { position: relative; z-index: 2; }
    .hero-eyebrow {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: var(--green); color: var(--green-dark);
      font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em;
      text-transform: uppercase; padding: 0.4rem 1rem; border-radius: 100px;
      margin-bottom: 1.2rem; animation: fadeUp 0.5s ease both;
    }
    .hero-eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green-dark); animation: pulse 2s ease infinite; }
    .hero-name {
      font-family: 'Playfair Display', serif;
      font-size: clamp(3.2rem, 7.5vw, 6.2rem);
      font-weight: 900; line-height: 0.95;
      color: var(--dark); letter-spacing: -0.02em;
      animation: fadeUp 0.6s 0.07s ease both;
    }
    .hero-name .accent { color: var(--pink); font-style: italic; }
    .hero-tagline {
      margin-top: 1.4rem;
      font-family: 'Playfair Display', serif;
      font-size: clamp(0.95rem, 1.6vw, 1.2rem);
      font-style: italic; line-height: 1.6; color: var(--text); max-width: 440px;
      animation: fadeUp 0.6s 0.14s ease both;
    }
    .hero-tagline strong { color: var(--pink); font-style: normal; font-weight: 900; }
    .hero-bio-pill {
      margin-top: 1.4rem; display: inline-block;
      background: var(--white); border: 1.5px solid var(--pink-pale);
      border-radius: var(--r-md); padding: 1rem 1.4rem;
      font-size: 0.85rem; line-height: 1.9; color: var(--text);
      max-width: 450px; box-shadow: var(--shadow-soft);
      animation: fadeUp 0.6s 0.2s ease both;
    }
    /* Scroll hint — sutil, sem botões de redes sociais no hero */
    .hero-scroll-hint {
      margin-top: 2rem;
      display: flex; align-items: center; gap: 0.6rem;
      animation: fadeUp 0.6s 0.27s ease both;
      color: var(--text-muted); font-size: 0.82rem;
    }
    .hero-scroll-hint .arrow {
      width: 32px; height: 32px; border-radius: 50%;
      background: var(--pink-ghost); color: var(--pink);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.9rem;
      animation: bounceDown 2s ease-in-out infinite;
    }

    .btn {
      display: inline-flex; align-items: center; gap: 0.45rem;
      padding: 0.7rem 1.4rem; border-radius: 100px;
      font-size: 0.84rem; font-weight: 700;
      transition: transform 0.2s, box-shadow 0.2s; cursor: pointer;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-pink    { background: var(--pink); color: #fff; box-shadow: 0 4px 18px rgba(255,63,164,0.35); }
    .btn-pink:hover  { box-shadow: 0 8px 28px rgba(255,63,164,0.5); }
    .btn-green   { background: var(--green); color: var(--green-dark); }
    .btn-green:hover { box-shadow: 0 8px 24px rgba(122,224,138,0.4); }
    .btn-outline { background: transparent; color: var(--pink); border: 2px solid var(--pink); }
    .btn-outline:hover { background: var(--pink-ghost); }

    /* HERO PHOTO */
    .hero-visual { position: relative; z-index: 2; display: flex; justify-content: center; align-items: center; animation: fadeIn 0.9s 0.15s ease both; }
    .photo-stack { position: relative; width: clamp(320px, 46vw, 560px); }
    .photo-deco {
      position: absolute; inset: -14px -14px auto auto;
      width: 100%; height: 100%;
      border-radius: 38% 62% 58% 42% / 44% 38% 62% 56%;
      background: var(--green); z-index: 0;
      animation: morphBlob 9s ease-in-out infinite alternate;
    }
    .photo-deco-2 {
      position: absolute; inset: 12px auto auto -14px;
      width: 80%; height: 80%;
      border-radius: 62% 38% 42% 58% / 56% 62% 38% 44%;
      background: var(--pink-pale); z-index: 0;
      animation: morphBlob2 11s ease-in-out infinite alternate;
    }
    .photo-frame {
      position: relative; z-index: 1; aspect-ratio: 4/3;
      border-radius: 38% 62% 58% 42% / 44% 38% 62% 56%;
      overflow: hidden; border: 4px solid var(--white);
      box-shadow: var(--shadow-pink);
      animation: morphBlob 9s ease-in-out infinite alternate;
    }
    .photo-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center center; }
    .photo-placeholder {
      width: 100%; height: 100%;
      background: linear-gradient(145deg, var(--pink-pale), var(--pink-light), var(--green));
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 0.7rem; padding: 2rem; text-align: center;
    }
    .photo-placeholder .ph-icon { font-size: 2.8rem; }
    .photo-placeholder p { font-family: 'Pacifico', cursive; font-size: 1rem; color: var(--pink); line-height: 1.5; }
    .photo-placeholder code { font-family: monospace; font-size: 0.7rem; background: rgba(255,63,164,0.12); color: var(--pink-hot); padding: 0.2rem 0.5rem; border-radius: 6px; }
    .trust-badge {
      position: absolute; bottom: 14px; left: -32px; z-index: 3;
      background: var(--white); border-radius: 20px; padding: 1rem 1.4rem;
      box-shadow: 0 10px 40px rgba(255,63,164,0.22); border-left: 4px solid var(--pink);
      animation: float 4.5s ease-in-out infinite; max-width: 185px;
    }
    .tb-num { font-family: 'Playfair Display', serif; font-size: 2rem; font-weight: 900; color: var(--pink); line-height: 1; }
    .tb-label { font-size: 0.7rem; font-weight: 600; color: var(--text-muted); line-height: 1.4; margin-top: 0.25rem; }
    .loc-badge {
      position: absolute; top: 14px; right: -16px; z-index: 3;
      background: var(--dark); color: #fff; border-radius: 100px;
      padding: 0.5rem 1rem; font-size: 0.72rem; font-weight: 700;
      display: flex; align-items: center; gap: 0.35rem;
      box-shadow: 0 4px 20px rgba(20,15,30,0.28);
      animation: float 5.5s 1s ease-in-out infinite;
    }

    /* TRUST STRIP */
    .trust-strip {
      background: linear-gradient(135deg, var(--pink) 0%, #FF6DB7 50%, var(--pink-light) 100%);
      padding: 3rem 4rem;
      display: grid; grid-template-columns: 1fr auto 1fr auto 1fr;
      gap: 0; align-items: center; position: relative; overflow: hidden;
    }
    .trust-strip::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(circle at 80% 50%, rgba(255,255,255,0.1), transparent 60%);
    }
    .ts-stat { text-align: center; position: relative; z-index: 1; }
    .ts-big { font-family: 'Playfair Display', serif; font-size: clamp(2.4rem,5vw,3.8rem); font-weight: 900; color: #fff; line-height: 1; }
    .ts-label { font-size: 0.78rem; color: rgba(255,255,255,0.85); margin-top: 0.4rem; line-height: 1.4; font-weight: 500; }
    .ts-div { width: 1px; height: 64px; background: rgba(255,255,255,0.25); }
    .ts-footer {
      grid-column: 1 / -1; text-align: center;
      padding: 1.2rem 2rem; margin-top: 1.5rem;
      background: rgba(0,0,0,0.12); border-radius: var(--r-md); position: relative; z-index: 1;
    }
    .ts-footer p { font-family: 'Playfair Display', serif; font-size: 1rem; font-style: italic; color: rgba(255,255,255,0.95); font-weight: 700; }

    /* SECTION DEFAULTS */
    .section-wrap { max-width: 1200px; margin: 0 auto; padding: 6rem 3rem; }
    .section-label { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--pink); margin-bottom: 0.7rem; }
    .section-title { font-family: 'Playfair Display', serif; font-size: clamp(2rem,4.5vw,3rem); font-weight: 900; line-height: 1.1; color: var(--dark); margin-bottom: 1.2rem; letter-spacing: -0.02em; }
    .section-title em { color: var(--pink); font-style: italic; }

    /* SOBRE */
    .sobre-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 5rem; align-items: center; }
    .sobre-img-wrap { position: relative; }
    .sobre-frame { border-radius: 28px; overflow: hidden; border: 3px solid var(--green); box-shadow: 10px 10px 0 var(--pink-pale); }
    .sobre-frame img { width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block; }
    .sobre-placeholder {
      aspect-ratio: 4/5;
      background: linear-gradient(135deg, var(--green), #d4fae0, var(--pink-pale));
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 0.7rem; padding: 2rem; text-align: center;
    }
    .sobre-placeholder .ph-icon { font-size: 3.2rem; }
    .sobre-placeholder p { font-family: 'Pacifico', cursive; font-size: 1rem; color: var(--pink); }
    .sobre-placeholder code { font-family: monospace; font-size: 0.72rem; background: rgba(255,63,164,0.1); color: var(--pink-hot); padding: 0.25rem 0.6rem; border-radius: 6px; }
    .sobre-tag { position: absolute; top: -16px; right: -16px; z-index: 2; background: var(--pink); color: #fff; font-size: 0.78rem; font-weight: 800; padding: 0.55rem 1.1rem; border-radius: var(--r-sm); box-shadow: 0 4px 18px rgba(255,63,164,0.4); }
    .sobre-text p { font-size: 0.95rem; line-height: 1.9; color: var(--text-muted); margin-bottom: 1rem; }
    .sobre-text p strong { color: var(--text); font-weight: 600; }
    .brand-callout { margin-top: 1.6rem; background: linear-gradient(135deg, #e8fdf0, var(--green)); border-radius: var(--r-md); padding: 1.3rem 1.6rem; border-left: 4px solid var(--green-dark); }
    .brand-callout p { font-size: 0.88rem; color: var(--dark); font-weight: 500; line-height: 1.75; margin: 0; }
    .brand-callout strong { color: var(--green-dark); }
    .chips { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; }
    .chip { padding: 0.42rem 1rem; border-radius: 100px; font-size: 0.8rem; font-weight: 600; background: var(--green); color: var(--green-dark); transition: transform 0.2s; }
    .chip:hover { transform: translateY(-2px); }

    /* STATS */
    .stats-section { background: var(--dark); border-radius: var(--r-xl); max-width: 1200px; margin: 0 auto; padding: 5rem 4rem; position: relative; overflow: hidden; }
    .stats-section::before { content: ''; position: absolute; top: -100px; right: -100px; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle, rgba(255,63,164,0.2), transparent 70%); pointer-events: none; }
    .stats-section::after  { content: ''; position: absolute; bottom: -80px; left: -80px; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(184,242,200,0.2), transparent 70%); pointer-events: none; }
    .stats-section .section-label { color: var(--green-mid); }
    .stats-section .section-title { color: #fff; }
    .stats-source { font-size: 0.8rem; color: rgba(255,255,255,0.38); margin-bottom: 2.5rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; }
    .stat-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 22px; padding: 1.8rem 1.5rem; transition: background 0.3s, transform 0.3s, border-color 0.3s; }
    .stat-card:hover { background: rgba(255,63,164,0.1); border-color: rgba(255,63,164,0.3); transform: translateY(-4px); }
    .stat-card.featured-stat { border-color: rgba(255,63,164,0.3); background: rgba(255,63,164,0.08); }
    .stat-num { font-family: 'Playfair Display', serif; font-size: 2.8rem; font-weight: 900; color: var(--pink); line-height: 1; }
    .stat-card.featured-stat .stat-num { color: var(--pink-light); }
    .stat-unit { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--green-mid); margin-top: 0.35rem; }
    .stat-desc { font-size: 0.78rem; color: rgba(255,255,255,0.45); margin-top: 0.25rem; line-height: 1.4; }
    .stat-ctx { margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px solid rgba(255,255,255,0.07); font-size: 0.73rem; color: var(--green-mid); font-style: italic; line-height: 1.4; }

    .format-dist { display: grid; grid-template-columns: repeat(3,1fr); gap: 1rem; margin-top: 2.5rem; }
    .fmt-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); border-radius: 18px; padding: 1.4rem; text-align: center; }
    .fmt-pct { font-family: 'Playfair Display', serif; font-size: 2.2rem; font-weight: 900; color: var(--pink-light); }
    .fmt-lbl { font-size: 0.73rem; color: rgba(255,255,255,0.4); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.25rem; }

    .audience-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.2rem; margin-top: 2.5rem; }
    .aud-card { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.07); border-radius: 18px; padding: 1.5rem; }
    .aud-title { font-size: 0.66rem; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; color: var(--green-mid); margin-bottom: 1.2rem; }
    .aud-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem; }
    .aud-l { font-size: 0.78rem; color: rgba(255,255,255,0.6); }
    .aud-v { font-size: 0.82rem; font-weight: 700; color: #fff; }
    .bar-track { background: rgba(255,255,255,0.07); border-radius: 100px; height: 5px; margin-bottom: 0.75rem; overflow: hidden; }
    .bar-fill { height: 5px; border-radius: 100px; background: linear-gradient(90deg, var(--pink), var(--pink-light)); transform-origin: left; transform: scaleX(0); transition: transform 1.2s cubic-bezier(0.22,1,0.36,1); }
    .bar-fill.green { background: linear-gradient(90deg, var(--green-mid), var(--green)); }

    /* MICRO */
    .micro-wrap { background: var(--white); border: 2px solid var(--pink-pale); border-radius: var(--r-xl); max-width: 1200px; margin: 0 auto; padding: 4rem; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
    .micro-text p { font-size: 0.94rem; color: var(--text-muted); line-height: 1.85; margin-bottom: 0.9rem; }
    .micro-text strong { color: var(--dark); font-weight: 700; }
    .micro-note { font-size: 0.76rem; color: var(--text-muted); font-style: italic; margin-top: -0.4rem; margin-bottom: 0.9rem; }
    .micro-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .mc { background: var(--cream-warm); border: 1.5px solid var(--pink-pale); border-radius: 20px; padding: 1.4rem; text-align: center; transition: transform 0.2s, box-shadow 0.2s; }
    .mc:hover { transform: translateY(-3px); box-shadow: var(--shadow-pink); }
    .mc .mc-i { font-size: 1.8rem; margin-bottom: 0.6rem; }
    .mc h4 { font-size: 0.84rem; font-weight: 700; color: var(--dark); margin-bottom: 0.3rem; }
    .mc p { font-size: 0.74rem; color: var(--text-muted); line-height: 1.4; }

    /* GALLERY */
    .portfolio-wrap { max-width: 1200px; margin: 0 auto; padding: 6rem 3rem; text-align: center; }

    /* PORTFOLIO GRID */
    .portfolio-intro {
      font-size: 0.95rem;
      color: var(--text-muted);
      max-width: 480px;
      margin: 0.5rem auto 2.5rem;
      line-height: 1.65;
    }
    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin-top: 2rem;
    }
    .pg-item {
      display: flex;
      flex-direction: column;
      align-items: stretch;
    }
    .pg-header {
      text-align: left;
      margin-bottom: 0.7rem;
      padding: 0 0.2rem;
    }
    .pc-tag {
      display: inline-block;
      font-size: 10px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
      padding: 5px 12px; border-radius: 100px;
      margin-bottom: 0.45rem;
    }
    .pg-title {
      display: block;
      font-family: 'Playfair Display', serif;
      font-size: 1rem; font-weight: 700;
      color: var(--dark);
      line-height: 1.3;
    }
    .tag-skincare { background: rgba(159, 225, 203, 0.4); color: #0F6E56; }
    .tag-make { background: rgba(244, 192, 209, 0.4); color: #993556; }
    .tag-skincare-make { background: rgba(206, 203, 246, 0.45); color: #534AB7; }
    .tag-fitness { background: rgba(245, 196, 179, 0.4); color: #993C1D; }
    .tag-reviews { background: rgba(181, 212, 244, 0.5); color: #185FA5; }
    .tag-ugc { background: rgba(250, 199, 117, 0.4); color: #854F0B; }
    .tag-ugc-unboxing { background: rgba(212, 169, 134, 0.35); color: #6b3e1f; }
    .tag-vlog { background: rgba(217, 217, 217, 0.5); color: #4a4a4a; }
    .tag-lifestyle { background: rgba(217, 217, 217, 0.5); color: #4a4a4a; }
    .pc-frame {
      background: #1a1a2e;
      border-radius: 18px;
      overflow: hidden;
      border: 3px solid #fff;
